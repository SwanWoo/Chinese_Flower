\documentclass[
$if(fontsize)$
  $fontsize$,
$endif$
  paper=a4,
  captions=tableheading
]{scrartcl}

\usepackage{amsmath,amssymb,amsfonts,mathtools}
\usepackage{iftex}
\usepackage{fontspec}
\usepackage{xeCJK}
\defaultfontfeatures{Scale=MatchLowercase,Ligatures=TeX}

$if(mainfont)$
  \setmainfont{$mainfont$}
$endif$
$if(sansfont)$
  \setsansfont{$sansfont$}
$endif$
$if(monofont)$
  \setmonofont{$monofont$}
$endif$
$if(CJKmainfont)$
  \setCJKmainfont[BoldFont={$if(CJKsansfont)$$CJKsansfont$$else$Heiti SC$endif$}]{$CJKmainfont$}
$endif$
$if(CJKsansfont)$
  \setCJKsansfont{$CJKsansfont$}
$endif$
$if(CJKmonofont)$
  \setCJKmonofont{$CJKmonofont$}
$endif$

\usepackage[dvipsnames,svgnames,x11names,table]{xcolor}
$if(geometry)$
\usepackage[$for(geometry)$$geometry$$sep$,$endfor$]{geometry}
$else$
\usepackage[margin=22mm,includehead=true,includefoot=true]{geometry}
$endif$

$if(linestretch)$
\usepackage{setspace}
\setstretch{$linestretch$}
$endif$

\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\newcommand{\pandocbounded}[1]{#1}

\usepackage{longtable,booktabs,array,calc}
\newcounter{none}
\usepackage{etoolbox}
\usepackage{caption}
\usepackage{float}
\floatplacement{figure}{H}

% Pandoc 3.x table and list support
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\setcounter{secnumdepth}{-\maxdimen}

% Syntax highlighting definitions from Pandoc
$if(highlighting-macros)$
$highlighting-macros$
$endif$

\newenvironment{cslreferences}{}{}

% Running headers and footers via KOMA-Script scrlayer-scrpage
\usepackage[headsepline=0.4pt]{scrlayer-scrpage}
\clearpairofpagestyles
$if(header-left)$
\ihead*{$header-left$}
$else$
\ihead*{$title$}
$endif$
\chead*{}
$if(header-right)$
\ohead*{$header-right$}
$endif$
\ifoot*{}
\cfoot*{\pagemark}
\ofoot*{}
\pagestyle{scrheadings}

\usepackage[unicode=true]{hyperref}
\hypersetup{
  pdftitle={$title$},
$if(author)$
  pdfauthor={$for(author)$$author$$sep$, $endfor$},
$endif$
  colorlinks=true,
  linkcolor=$if(linkcolor)$$linkcolor$$else$NavyBlue$endif$,
  urlcolor=$if(urlcolor)$$urlcolor$$else$NavyBlue$endif$,
  citecolor=$if(citecolor)$$citecolor$$else$NavyBlue$endif$,
  pdfborder={0 0 0},
  breaklinks=true
}
\usepackage{bookmark}

% Titlepage colors
$if(titlepage-color)$
\definecolor{titlepagecolor}{HTML}{$titlepage-color$}
$else$
\definecolor{titlepagecolor}{HTML}{F7F9FB}
$endif$
$if(titlepage-text-color)$
\definecolor{titlepagetextcolor}{HTML}{$titlepage-text-color$}
$else$
\definecolor{titlepagetextcolor}{HTML}{1F2933}
$endif$
$if(titlepage-rule-color)$
\definecolor{titlepagerulecolor}{HTML}{$titlepage-rule-color$}
$else$
\definecolor{titlepagerulecolor}{HTML}{2F5D7C}
$endif$

$for(header-includes)$
$header-includes$
$endfor$

\begin{document}

$if(titlepage)$
\begin{titlepage}
\newgeometry{margin=25mm}
\pagecolor{titlepagecolor}
\color{titlepagetextcolor}
\vspace*{3cm}
{\noindent\sffamily\bfseries\fontsize{24}{30}\selectfont $title$\par}
$if(subtitle)$
\vspace{0.8cm}
{\noindent\sffamily\fontsize{14}{20}\selectfont $subtitle$\par}
$endif$
\vspace{0.8cm}
{\color{titlepagerulecolor}\rule{\linewidth}{$if(titlepage-rule-height)$$titlepage-rule-height$pt$else$2pt$endif$}}
\vfill
$if(author)$
{\noindent\sffamily\fontsize{12}{16}\selectfont \textbf{作者 / 整理：}$for(author)$$author$$sep$, $endfor$\par}
\vspace{0.3cm}
$endif$
$if(date)$
{\noindent\sffamily\fontsize{12}{16}\selectfont \textbf{日期：}$date$\par}
$endif$
\vspace*{1.5cm}
\end{titlepage}
\nopagecolor
\restoregeometry
$endif$

$if(toc)$
$if(toc-title)$
\renewcommand*\contentsname{$toc-title$}
$endif$
{
\hypersetup{linkcolor=black}
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
$if(toc-own-page)$
\newpage
$endif$
$endif$

$body$

\end{document}
